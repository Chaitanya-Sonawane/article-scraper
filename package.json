{
  "name": "article-scraper-ai-rewriter",
  "version": "1.0.0",
  "description": "A full-stack web application that scrapes articles and uses AI to rewrite them intelligently",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:frontend": "cd frontend && npm start",
    "build:frontend": "cd frontend && npm run build",
    "start:all": "concurrently \"npm run dev\" \"npm run start:frontend\"",
    "setup:all": "npm install && cd frontend && npm install && cd .. && cp .env.example .env",
    "scrape": "node scripts/run-scraper.js",
    "ai-pipeline": "node scripts/run-ai-pipeline.js",
    "demo-ai-pipeline": "node scripts/run-demo-ai-pipeline.js",
    "test-scraper": "node scripts/test-scraper.js",
    "test:db": "node -e \"require('./src/config/db.js')\"",
    "test:openai": "node -e \"console.log('OpenAI API Key:', process.env.OPENAI_API_KEY ? 'Set' : 'Not Set')\"",
    "test:all": "npm run test:db && npm run test:openai && npm run test-scraper",
    "logs": "tail -f logs/app.log",
    "lint": "eslint . --ext .js",
    "format": "prettier --write .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "web-scraping",
    "ai-rewriting",
    "openai",
    "article-processing",
    "content-management",
    "nodejs",
    "express",
    "mongodb",
    "react"
  ],
  "author": "Chaitanya Sonawane",
  "license": "MIT",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "axios": "^1.13.2",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsdom": "^26.1.0",
    "mongoose": "^8.20.4",
    "openai": "^4.104.0",
    "puppeteer": "^23.10.4",
    "undici": "^5.28.4"
  }
}
